{
  "name": "r2-share",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "bun scripts/configure-d1.mjs && wrangler d1 migrations apply DB --local --config wrangler.generated.jsonc && vite",
    "build": "bun scripts/configure-d1.mjs && vite build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:migrate": "bun scripts/configure-d1.mjs && wrangler d1 migrations apply DB --remote --config wrangler.generated.jsonc",
    "deploy:publish": "bun run db:migrate && bun run build && wrangler deploy",
    "deploy": "bun run deploy:publish"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.10.0",
    "lucide-react": "^0.500.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.0",
    "aws4fetch": "^1.0.18",
    "@base-ui/react": "^1.9.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "latest",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "7.1.0-beta",
    "vite": "^7.0.0",
    "wrangler": "^4.45.0"
  }
}
