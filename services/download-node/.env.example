# Example only. Supply the shared secret through protected environment variables.
# HTTP behind an HTTPS reverse proxy. Defaults to :8080 without TLS files.
LISTEN_ADDR=:8080
# Match the public HTTPS hostname configured in TuckBox Admin.
# The reverse proxy must preserve the original Host header.
NODE_DOMAIN=dl1.example.com
# Set BOTH files for native HTTPS (and use LISTEN_ADDR=:8443).
# TLS_CERT_FILE=/certs/fullchain.pem
# TLS_KEY_FILE=/certs/privkey.pem
# Generate one shared secret: openssl rand -hex 32
DOWNLOAD_NODE_SECRET=replace-with-a-64-character-unique-shared-secret
# Optional, only needed for cross-origin fetch clients.
CORS_ORIGIN=https://share.example.com
