{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "r2-share",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-05",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "triggers": {
    "crons": [
      "0 */6 * * *"
    ]
  },
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "CODE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 15,
        "period": 60
      }
    }
  ],
  "keep_vars": true,
  "secrets": {
    "required": [
      "APP_MASTER_KEY",
      "ADMIN_PATH",
      "ADMIN_PASSWORD"
    ]
  }
}
