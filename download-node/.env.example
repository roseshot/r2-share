# Example only. Supply real values through protected environment variables.
LISTEN_ADDR=:8080
# Generate one shared secret: openssl rand -hex 32
DOWNLOAD_NODE_SECRET=replace-with-a-64-character-unique-shared-secret
# Match the exact storage IDs configured in TuckBox Admin.
STORAGES_JSON=[{"id":"b2-primary","backend":"b2","bucket":"my-private-bucket","region":"us-west-004","keyId":"REPLACE","applicationKey":"REPLACE"}]
# Optional, only needed for cross-origin fetch clients.
CORS_ORIGIN=https://share.example.com
